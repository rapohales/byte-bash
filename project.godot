; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false
resources_spreadsheet_view/fold_docks=true
resources_spreadsheet_view/resource_cell_label_mode=1
resources_spreadsheet_view/freeze_first_column=true

[application]

config/name="jogo-cyber"
run/main_scene="uid://wsaav34en06a"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=60

[autoload]

EventBus="*res://Scripts/EventBus.gd"
Main="*res://Scripts/main.gd"

[display]

window/size/viewport_width=1500
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0
window/ios/allow_high_refresh_rate=false

[dotnet]

project/assembly_name="jogo-cyber"

[file_customization]

folder_colors={
"res://Assets/": "red",
"res://Cenas/": "orange",
"res://Scripts/": "green"
}

[global_group]

enemies=""
jogador=""
bosses=""

